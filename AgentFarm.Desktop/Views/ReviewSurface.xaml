<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentFarm_Desktop.Views.ReviewSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AgentFarm_Desktop.Models">
    <Border Padding="18" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Uid="ReviewTitle" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" Text="Candidate review" />
                <TextBlock x:Name="ReviewStateLabel" Grid.Column="1" FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind ViewModel.State, Mode=OneWay}" />
                <TextBlock x:Name="ReviewDecisionSummary" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Decision, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock x:Name="ReviewCostSummary" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Cost, Mode=OneWay}" TextWrapping="Wrap" />
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource MutedTextBrush}" x:Uid="CandidateA" Text="CANDIDATE A" />
                    <ComboBox x:Name="CandidateACombo" AutomationProperties.AutomationId="CandidateACombo" AutomationProperties.Name="Candidate A" DisplayMemberPath="DisplayName" SelectionChanged="OnCandidateChanged" />
                    <TextBlock x:Name="SummaryA" FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource MutedTextBrush}" x:Uid="CandidateB" Text="CANDIDATE B" />
                    <ComboBox x:Name="CandidateBCombo" AutomationProperties.AutomationId="CandidateBCombo" AutomationProperties.Name="Candidate B" DisplayMemberPath="DisplayName" SelectionChanged="OnCandidateChanged" />
                    <TextBlock x:Name="SummaryB" FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBox x:Name="DiffA" AutomationProperties.AutomationId="ReviewDiffA" AutomationProperties.Name="Candidate A diff" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="{StaticResource SmallFontSize}" IsReadOnly="True" TextWrapping="NoWrap" />
                <TextBox x:Name="DiffB" Grid.Column="1" AutomationProperties.AutomationId="ReviewDiffB" AutomationProperties.Name="Candidate B diff" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="{StaticResource SmallFontSize}" IsReadOnly="True" TextWrapping="NoWrap" />
            </Grid>
            <ComboBox x:Name="CheckpointCombo" x:Uid="CheckpointHistory" Grid.Row="3" AutomationProperties.AutomationId="CheckpointCombo" AutomationProperties.Name="Checkpoint history" DisplayMemberPath="DisplayName" Header="Checkpoint history" SelectionChanged="OnCheckpointChanged" />
            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="ApplyButton" x:Uid="ApplyVerify" AutomationProperties.AutomationId="ApplyCandidateButton" AutomationProperties.Name="Apply and verify selected candidate" Command="{x:Bind ViewModel.RequestApplyCommand}" Content="Apply + verify" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="MergeButton" x:Uid="MergeCandidate" Grid.Column="1" AutomationProperties.AutomationId="MergeCandidateButton" AutomationProperties.Name="Merge verified candidate" Command="{x:Bind ViewModel.RequestMergeCommand}" Content="Merge" />
                <Button x:Name="RollbackButton" x:Uid="RollbackCandidate" Grid.Column="2" AutomationProperties.AutomationId="RollbackCandidateButton" AutomationProperties.Name="Rollback selected checkpoint" Command="{x:Bind ViewModel.RequestRollbackCommand}" Content="Rollback" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
