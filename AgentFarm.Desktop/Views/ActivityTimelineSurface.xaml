<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentFarm_Desktop.Views.ActivityTimelineSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AgentFarm_Desktop.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ActivityTemplate" x:DataType="models:TimelineEntry">
            <Grid Margin="0,5,0,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AccentSoftBrush}"
                        CornerRadius="{StaticResource AvatarCornerRadius}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource BodyFontSize}"
                        Glyph="{x:Bind Glyph}" />
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="16,13"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <StackPanel Spacing="7">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold" Text="{x:Bind Kind}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="{StaticResource BodyStrongFontSize}"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                FontSize="{StaticResource SmallFontSize}"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="{x:Bind Status}" />
                            <TextBlock
                                Grid.Column="3"
                                FontSize="{StaticResource SmallFontSize}"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="{x:Bind TimeLabel}" />
                        </Grid>
                        <TextBlock
                            FontSize="{StaticResource BodyStrongFontSize}"
                            Foreground="{ThemeResource MutedTextBrush}"
                            IsTextSelectionEnabled="True"
                            LineHeight="19"
                            Text="{x:Bind Body}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <StackPanel
            x:Name="EmptyState"
            Width="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="13">
            <Border
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                Background="{ThemeResource AccentSoftBrush}"
                                CornerRadius="{StaticResource AvatarCornerRadius}">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource TitleFontSize}"
                    Glyph="&#xE945;" />
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="{StaticResource HeroFontSize}"
                FontWeight="SemiBold"
                x:Uid="EmptyTitle"
                Text="What should the farm accomplish?" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource MutedTextBrush}"
                x:Uid="EmptyDescription"
                Text="A high-capability Supervisor creates the plan. Economical Workers execute isolated parts in parallel."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            x:Name="ActivityList"
            AutomationProperties.AutomationId="ActivityTimeline"
            AutomationProperties.Name="Task activity timeline"
            ItemContainerTransitions="{x:Null}"
            ItemTemplate="{StaticResource ActivityTemplate}"
            SelectionMode="None" />
    </Grid>
</UserControl>
