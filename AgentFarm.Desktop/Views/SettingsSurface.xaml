<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentFarm_Desktop.Views.SettingsSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AgentFarm_Desktop.Models"
    xmlns:views="using:AgentFarm_Desktop.Views">

    <UserControl.Resources>
        <Style x:Key="SettingsNavigationButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource CompactCornerRadius}" />
        </Style>
        <DataTemplate x:Key="ProfileEditorTemplate" x:DataType="models:WorkerProfileEditor">
            <StackPanel Padding="2,6" Spacing="3">
                <TextBlock FontSize="{StaticResource BodyStrongFontSize}" FontWeight="SemiBold" Text="{x:Bind DisplayName, Mode=OneWay}" />
                <TextBlock FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind RouteSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SettingsBackButton"
                x:Uid="SettingsBack"
                AutomationProperties.AutomationId="SettingsBackButton"
                AutomationProperties.Name="Back"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.ReturnFromSettingsCommand}"
                ToolTipService.ToolTip="Back (Alt+Left)">
                <FontIcon FontSize="{StaticResource SubtitleFontSize}" Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Uid="SettingsTitle" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" Text="Settings" />
                <TextBlock x:Uid="SettingsSubtitle" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="Native model routing and provider configuration. Changes apply to new runs." />
            </StackPanel>
            <Button x:Name="SaveButton" x:Uid="SaveSettings" AutomationProperties.AutomationId="SaveSettingsButton" AutomationProperties.Name="Save settings" Grid.Column="2" Click="OnSave" Style="{StaticResource AccentButtonStyle}" Content="Save settings" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="22,10,14,18" Spacing="4">
                <Button x:Name="AgentRoutesButton" AutomationProperties.AutomationId="AgentRoutesSettingsButton" AutomationProperties.Name="Agent routes settings" Command="{x:Bind ViewModel.ShowAgentRoutesCommand}" Style="{StaticResource SettingsNavigationButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="{StaticResource SubtitleFontSize}" Glyph="&#xE945;" />
                        <TextBlock x:Uid="AgentRoutesLabel" Text="Agent routes" />
                    </StackPanel>
                </Button>
                <Button x:Name="ProvidersButton" AutomationProperties.AutomationId="ProvidersSettingsButton" AutomationProperties.Name="Provider settings" Command="{x:Bind ViewModel.ShowProvidersCommand}" Style="{StaticResource SettingsNavigationButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="{StaticResource SubtitleFontSize}" Glyph="&#xE774;" />
                        <TextBlock x:Uid="ProvidersLabel" Text="Providers" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportDiagnosticsButton" x:Uid="ExportDiagnostics" AutomationProperties.AutomationId="ExportDiagnosticsButton" AutomationProperties.Name="Export diagnostic bundle" Click="OnExportDiagnostics" Style="{StaticResource SettingsNavigationButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="{StaticResource SubtitleFontSize}" Glyph="&#xE9D9;" />
                        <TextBlock x:Uid="ExportDiagnosticsLabel" Text="Export diagnostics" />
                    </StackPanel>
                </Button>
                <TextBlock x:Uid="ConfigFileLabel" Margin="10,18,0,0" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="CONFIG FILE" />
                <TextBlock Margin="10,0,0,0" FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind ViewModel.SettingsPath, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock x:Uid="DiagnosticBundleLabel" Margin="10,14,0,0" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="LAST DIAGNOSTIC BUNDLE" />
                <TextBlock AutomationProperties.AutomationId="DiagnosticBundlePath" Margin="10,0,0,0" FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind ViewModel.DiagnosticBundlePath, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock x:Uid="UpdatesLabel" Margin="10,14,0,0" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="UPDATES" />
                <ComboBox x:Name="ReleaseChannelCombo" x:Uid="ReleaseChannel" AutomationProperties.AutomationId="ReleaseChannelCombo" AutomationProperties.Name="Release channel" Header="Release channel" SelectionChanged="OnReleaseChannelChanged">
                    <x:String>stable</x:String>
                    <x:String>preview</x:String>
                </ComboBox>
                <Button x:Name="CheckUpdatesButton" x:Uid="CheckUpdates" AutomationProperties.AutomationId="CheckUpdatesButton" AutomationProperties.Name="Check for updates" Click="OnCheckUpdates" Content="Check for updates" />
                <Button x:Name="InstallUpdateButton" x:Uid="InstallUpdate" AutomationProperties.AutomationId="InstallUpdateButton" AutomationProperties.Name="Download and install update" Click="OnInstallUpdate" Content="Download update" IsEnabled="False" />
                <TextBlock AutomationProperties.AutomationId="UpdateStatusText" FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
            <Rectangle Grid.Column="1" Fill="{ThemeResource SubtleBorderBrush}" />

            <ScrollViewer Grid.Column="2" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <Grid HorizontalAlignment="Stretch">
                    <StackPanel x:Name="AgentRoutesPanel" MaxWidth="1000" Margin="30,14,30,28" HorizontalAlignment="Stretch" Spacing="18" Visibility="{x:Bind views:SettingsSurface.BoolToVisibility(ViewModel.Settings.IsAgentRoutesVisible), Mode=OneWay}">
                        <StackPanel Spacing="3">
                            <TextBlock x:Uid="AgentRoutesTitle" FontSize="{StaticResource SectionFontSize}" FontWeight="SemiBold" Text="Agent routes" />
                            <TextBlock x:Uid="AgentRoutesDescription" Foreground="{ThemeResource MutedTextBrush}" Text="Use an expensive model for planning and economical models for parallel execution." />
                        </StackPanel>

                        <Border Padding="18" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Uid="SupervisorTitle" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" Text="Supervisor" />
                                    <TextBlock x:Uid="SupervisorDescription" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="Read-only planner and final reviewer. Choose the strongest model here." />
                                </StackPanel>
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ComboBox x:Name="SupervisorHarnessCombo" AutomationProperties.AutomationId="SupervisorHarnessCombo" AutomationProperties.Name="Supervisor harness" Header="Harness" DisplayMemberPath="DisplayName" ItemsSource="{x:Bind ViewModel.HarnessOptions, Mode=OneWay}" SelectedValuePath="Id" Grid.ColumnSpan="2" />
                                    <ComboBox x:Name="SupervisorProviderCombo" x:Uid="SupervisorProvider" AutomationProperties.AutomationId="SupervisorProviderCombo" AutomationProperties.Name="Supervisor provider" Header="Provider" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}" SelectedValuePath="Id" Grid.Row="1" SelectionChanged="OnSupervisorProviderSelectionChanged" />
                                    <ComboBox x:Name="SupervisorModelCombo" x:Uid="SupervisorModel" AutomationProperties.AutomationId="SupervisorModelCombo" AutomationProperties.Name="Supervisor model" Grid.Row="1" Grid.Column="1" Header="Model" DisplayMemberPath="DisplayName" ItemsSource="{x:Bind ViewModel.SupervisorModels, Mode=OneWay}" SelectedValuePath="Id" SelectionChanged="OnSupervisorModelSelectionChanged" />
                                    <TextBox x:Name="SupervisorCustomModelBox" x:Uid="SupervisorCustomModel" AutomationProperties.AutomationId="SupervisorCustomModelBox" AutomationProperties.Name="Gateway model ID" Grid.Row="2" Grid.ColumnSpan="2" Header="Model ID (gateway)" PlaceholderText="Enter an exact ID, for example openai/gpt-5.5 or anthropic/claude-sonnet-4.5" TextChanged="OnSupervisorCustomModelChanged" />
                                    <ComboBox x:Name="SupervisorThinkingCombo" x:Uid="SupervisorThinking" AutomationProperties.AutomationId="SupervisorThinkingCombo" AutomationProperties.Name="Supervisor thinking mode" Grid.Row="3" Header="Thinking" ItemsSource="{x:Bind ViewModel.SupervisorThinkingOptions, Mode=OneWay}" />
                                    <ComboBox x:Name="SupervisorEffortCombo" x:Uid="SupervisorEffort" AutomationProperties.AutomationId="SupervisorEffortCombo" AutomationProperties.Name="Supervisor reasoning effort" Grid.Row="3" Grid.Column="1" Header="Reasoning effort" ItemsSource="{x:Bind ViewModel.SupervisorEffortOptions, Mode=OneWay}" />
                                </Grid>
                                <StackPanel Margin="0,2,0,0" Spacing="3">
                                    <CheckBox
                                        x:Name="NetworkAccessCheckBox"
                                        AutomationProperties.AutomationId="NetworkAccessCheckBox"
                                        AutomationProperties.Name="Allow public web research"
                                        Content="Allow public web research" />
                                    <TextBlock
                                        Margin="30,0,0,0"
                                        FontSize="{StaticResource SmallFontSize}"
                                        Foreground="{ThemeResource MutedTextBrush}"
                                        Text="Workers can use web search and fetch public pages when a task needs current information. Local and private addresses remain blocked."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="18" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Uid="CostBudgetsTitle" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" Text="Cost budgets" />
                                    <TextBlock x:Uid="CostBudgetsDescription" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="Zero means unlimited. Hard stop blocks the next model request after a limit is exhausted." TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox x:Name="FarmBudgetBox" AutomationProperties.AutomationId="FarmBudgetBox" AutomationProperties.Name="Per-Farm budget in US dollars" Header="Per-Farm budget (USD)" Minimum="0" SmallChange="0.10" SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="MonthlyBudgetBox" Grid.Column="1" AutomationProperties.AutomationId="MonthlyBudgetBox" AutomationProperties.Name="Monthly application budget in US dollars" Header="Monthly app budget (USD)" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                    <ComboBox x:Name="BudgetPolicyCombo" Grid.Row="1" AutomationProperties.AutomationId="BudgetPolicyCombo" AutomationProperties.Name="Budget policy" Header="Budget policy">
                                        <x:String>warn</x:String>
                                        <x:String>hard-stop</x:String>
                                    </ComboBox>
                                    <NumberBox x:Name="BudgetWarningRatioBox" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="BudgetWarningRatioBox" AutomationProperties.Name="Budget warning threshold" Header="Warning threshold (0-1)" Maximum="1" Minimum="0.01" SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="18" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Uid="WorkerRoutesTitle" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" Text="Worker routes" />
                                        <TextBlock x:Uid="WorkerRoutesDescription" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="Each plan assigns one of these low-cost execution profiles." />
                                    </StackPanel>
                                    <Button x:Uid="AddRoute" AutomationProperties.AutomationId="AddWorkerRouteButton" AutomationProperties.Name="Add worker route" HorizontalAlignment="Right" Click="OnAddWorkerProfile" Content="Add route" />
                                </Grid>
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="10">
                                        <ComboBox x:Name="DefaultWorkerProfileCombo" AutomationProperties.AutomationId="DefaultWorkerProfileCombo" AutomationProperties.Name="Default worker route" Header="Default worker route" DisplayMemberPath="DisplayName" ItemsSource="{x:Bind ViewModel.WorkerProfiles, Mode=OneWay}" SelectedValuePath="Name" />
                                        <ListView x:Name="WorkerProfileList" AutomationProperties.AutomationId="WorkerProfileList" AutomationProperties.Name="Worker routes" Height="270" ItemTemplate="{StaticResource ProfileEditorTemplate}" ItemsSource="{x:Bind ViewModel.WorkerProfiles, Mode=OneWay}" SelectionChanged="OnWorkerProfileSelectionChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="WorkerProfileEditorPanel" Grid.Column="1" Spacing="10">
                                        <TextBox Header="Route ID" IsReadOnly="True" Text="{Binding Name, Mode=OneWay}" />
                                        <TextBox Header="Display name" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox x:Name="WorkerHarnessCombo" AutomationProperties.AutomationId="WorkerHarnessCombo" AutomationProperties.Name="Worker harness" Header="Harness" DisplayMemberPath="DisplayName" ItemsSource="{x:Bind ViewModel.HarnessOptions, Mode=OneWay}" SelectedValuePath="Id" SelectedValue="{Binding Harness, Mode=TwoWay}" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="WorkerProviderCombo" AutomationProperties.AutomationId="WorkerProviderCombo" AutomationProperties.Name="Worker provider" Header="Provider" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}" SelectedValuePath="Id" SelectionChanged="OnWorkerProviderSelectionChanged" />
                                            <ComboBox x:Name="WorkerModelCombo" AutomationProperties.AutomationId="WorkerModelCombo" AutomationProperties.Name="Worker model" Grid.Column="1" Header="Model" DisplayMemberPath="DisplayName" ItemsSource="{x:Bind ViewModel.WorkerModels, Mode=OneWay}" SelectedValuePath="Id" SelectionChanged="OnWorkerModelSelectionChanged" />
                                        </Grid>
                                        <TextBox x:Name="WorkerCustomModelBox" AutomationProperties.AutomationId="WorkerCustomModelBox" AutomationProperties.Name="Gateway model ID" Header="Model ID (gateway)" PlaceholderText="Enter an exact model ID when using a compatible gateway" TextChanged="OnWorkerCustomModelChanged" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="WorkerThinkingCombo" AutomationProperties.AutomationId="WorkerThinkingCombo" AutomationProperties.Name="Worker thinking mode" Header="Thinking" ItemsSource="{x:Bind ViewModel.WorkerThinkingOptions, Mode=OneWay}" />
                                            <ComboBox x:Name="WorkerEffortCombo" AutomationProperties.AutomationId="WorkerEffortCombo" AutomationProperties.Name="Worker reasoning effort" Grid.Column="1" Header="Reasoning effort" ItemsSource="{x:Bind ViewModel.WorkerEffortOptions, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="Model inference has no time limit. It continues until the model finishes or you close Agent Farm." TextWrapping="Wrap" />
                                        <NumberBox x:Name="WorkerBudgetBox" AutomationProperties.AutomationId="WorkerBudgetBox" AutomationProperties.Name="Per-Worker budget in US dollars" Header="Per-Worker budget (USD, 0 = unlimited)" Minimum="0" SmallChange="0.10" SpinButtonPlacementMode="Compact" Value="{Binding BudgetUsd, Mode=TwoWay}" />
                                        <ComboBox x:Name="WorkerCapabilityCombo" AutomationProperties.AutomationId="WorkerCapabilityCombo" AutomationProperties.Name="Worker capability tier" Header="Capability tier" SelectedItem="{Binding CapabilityTier, Mode=TwoWay}">
                                            <x:String>economy</x:String>
                                            <x:String>standard</x:String>
                                            <x:String>premium</x:String>
                                        </ComboBox>
                                        <Button x:Uid="RemoveRoute" AutomationProperties.AutomationId="RemoveWorkerRouteButton" AutomationProperties.Name="Remove worker route" HorizontalAlignment="Left" Click="OnRemoveWorkerProfile" Content="Remove route" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <views:ProviderSurface x:Name="ProviderSettings" Providers="{x:Bind ViewModel.Providers, Mode=OneWay}" Templates="{x:Bind ViewModel.ProviderTemplates, Mode=OneWay}" Visibility="{x:Bind views:SettingsSurface.BoolToVisibility(ViewModel.Settings.IsProvidersVisible), Mode=OneWay}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
