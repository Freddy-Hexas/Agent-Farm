<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentFarm_Desktop.Views.WorkspaceSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:AgentFarm_Desktop.Models"
    xmlns:views="using:AgentFarm_Desktop.Views">

    <UserControl.Resources>
        <DataTemplate x:Key="NotificationTemplate" x:DataType="models:NotificationItem">
            <Grid Padding="6,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon FontSize="{StaticResource BodyFontSize}" Glyph="{x:Bind Glyph}" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock FontSize="{StaticResource BodyStrongFontSize}" FontWeight="SemiBold" Text="{x:Bind Title}" />
                    <TextBlock FontSize="{StaticResource SmallFontSize}" Foreground="{ThemeResource MutedTextBrush}" MaxLines="3" Text="{x:Bind Message}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind TimeLabel}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="WorkspacePaneSplitterStyle" TargetType="controls:GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsThumbVisible" Value="False" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="KeyboardIncrement" Value="8" />
            <Setter Property="DragIncrement" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="{StaticResource PaneMaxWidth}" />
            <ColumnDefinition x:Name="ExecutionSplitterColumn" Width="{StaticResource PaneSplitterWidth}" />
            <ColumnDefinition x:Name="ExecutionPaneColumn" Width="{StaticResource ExecutionPaneWidth}" MinWidth="{StaticResource ExecutionPaneMinWidth}" MaxWidth="{StaticResource PaneMaxWidth}" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="{StaticResource WorkspaceHeaderPadding}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" />
                    <TextBlock FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind ViewModel.CurrentSubtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="NotificationCenterButton" AutomationProperties.AutomationId="NotificationCenterButton" AutomationProperties.Name="Open notification queue" ToolTipService.ToolTip="Notifications">
                        <Grid>
                            <FontIcon FontSize="{StaticResource BodyFontSize}" Glyph="&#xE7F4;" />
                            <Border x:Name="NotificationCountBadge" MinWidth="14" Height="14" Margin="9,-8,-10,0" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="{StaticResource CompactCornerRadius}" Visibility="Collapsed">
                                <TextBlock x:Name="NotificationCountLabel" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource BadgeFontSize}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Grid Width="380" MaxHeight="440">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid Margin="8,4,8,8">
                                        <TextBlock x:Uid="NotificationsLabel" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" Text="Notifications" />
                                        <Button HorizontalAlignment="Right" AutomationProperties.Name="Clear notification queue" Command="{x:Bind ClearNotificationsCommand}" Content="Clear" />
                                    </Grid>
                                    <ListView x:Name="NotificationQueue" Grid.Row="1" AutomationProperties.AutomationId="NotificationQueue" AutomationProperties.Name="Notification queue" ItemTemplate="{StaticResource NotificationTemplate}" SelectionMode="None" />
                                    <TextBlock x:Name="NotificationEmptyState" x:Uid="NotificationEmpty" Grid.Row="1" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" Text="No notifications yet." />
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="ToggleExecutionButton" AutomationProperties.AutomationId="ToggleExecutionPaneButton" AutomationProperties.Name="Collapse execution pane" Click="OnToggleExecutionPane" ToolTipService.ToolTip="Show or hide execution details">
                        <FontIcon x:Name="ExecutionPaneToggleIcon" FontSize="{StaticResource BodyFontSize}" Glyph="&#xE76B;" />
                    </Button>
                    <Button AutomationProperties.AutomationId="RefreshWorkspaceButton" AutomationProperties.Name="Refresh task state" Click="OnRefresh" ToolTipService.ToolTip="Refresh task state">
                        <FontIcon FontSize="{StaticResource BodyFontSize}" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,0,20,6" Spacing="6">
                <InfoBar
                    x:Name="RuntimeStateBar"
                    AutomationProperties.AutomationId="RuntimeStateBar"
                    AutomationProperties.Name="Runtime connection state"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.RuntimeState.IsBannerVisible, Mode=OneWay, FallbackValue=False}"
                    Message="{x:Bind ViewModel.RuntimeState.Message, Mode=OneWay, FallbackValue='Runtime connection unavailable.'}"
                    Severity="Warning"
                    Title="{x:Bind ViewModel.RuntimeState.Title, Mode=OneWay, FallbackValue='Runtime status'}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="ReconnectRuntime" AutomationProperties.Name="Reconnect local runtime" Click="OnRetryRuntime" Content="Reconnect" IsEnabled="{x:Bind ViewModel.RuntimeState.CanRecover, Mode=OneWay, FallbackValue=False}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="NotificationBar" IsClosable="True" IsOpen="False" Severity="Informational" />
            </StackPanel>

            <views:ActivityTimelineSurface x:Name="Timeline" Grid.Row="2" Margin="24,0,20,0" ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}" />

            <views:ComposerSurface
                x:Name="Composer"
                Grid.Row="3"
                Margin="24,10,20,18"
                Attachments="{x:Bind ViewModel.Attachments, Mode=OneWay}"
                RepositoryName="{x:Bind ViewModel.RepositoryName, Mode=OneWay}"
                SupervisorRoute="{x:Bind ViewModel.SupervisorRoute, Mode=OneWay}" />
        </Grid>

        <Rectangle x:Name="ExecutionPaneDivider" Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{ThemeResource SubtleBorderBrush}" IsHitTestVisible="False" />
        <controls:GridSplitter
            x:Name="ExecutionPaneSplitter"
            AutomationProperties.AutomationId="RightPaneSplitter"
            AutomationProperties.Name="Resize execution pane"
            Grid.Column="1"
            DoubleTapped="OnExecutionSplitterDoubleTapped"
            Style="{StaticResource WorkspacePaneSplitterStyle}"
            ToolTipService.ToolTip="Drag to resize execution. Double-click to reset." />

        <views:ExecutionSurface
            x:Name="Execution"
            Grid.Column="2"
            LiveAgents="{x:Bind ViewModel.LiveAgents, Mode=OneWay}"
            PendingApprovals="{x:Bind ViewModel.PendingApprovals, Mode=OneWay}"
            PlannedWorkers="{x:Bind ViewModel.PlannedWorkers, Mode=OneWay}"
            SizeChanged="OnExecutionSizeChanged"
            SupervisorMode="{x:Bind ViewModel.SupervisorMode, Mode=OneWay}"
            SupervisorRoute="{x:Bind ViewModel.SupervisorRoute, Mode=OneWay}"
            ViewModel="{x:Bind ViewModel.Execution, Mode=OneWay}" />
    </Grid>
</UserControl>
