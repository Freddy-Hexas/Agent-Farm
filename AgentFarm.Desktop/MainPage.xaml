<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AgentFarm_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#F7F7F5"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Grid>
        <WebView2 x:Name="AgentWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Grid
            x:Name="LoadingOverlay"
            Background="#F7F7F5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <ProgressRing
                    Width="28"
                    Height="28"
                    IsActive="True" />
                <TextBlock
                    Foreground="#6E6E6E"
                    FontSize="13"
                    Text="Starting Agent Farm..." />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="StartupError"
            Margin="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="Agent Farm could not start">
            <InfoBar.ActionButton>
                <Button Click="OnChooseRepository" Content="Choose repository" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
