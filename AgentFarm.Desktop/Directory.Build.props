<Project>
  <PropertyGroup>
    <AgentFarmWinUIAnalyzerRoot Condition="'$(AgentFarmWinUIAnalyzerRoot)' == ''">$(USERPROFILE)\.codex\plugins\cache\microsoft-winui\winui\0.3.0\skills\winui-dev-workflow\analyzer</AgentFarmWinUIAnalyzerRoot>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(AgentFarmWinUIAnalyzerRoot)\Microsoft.WindowsAppSDK.Analyzers.dll')">
    <Analyzer Include="$(AgentFarmWinUIAnalyzerRoot)\Microsoft.WindowsAppSDK.Analyzers.dll" />
  </ItemGroup>
  <Import
    Project="$(AgentFarmWinUIAnalyzerRoot)\Microsoft.WindowsAppSDK.Analyzers.targets"
    Condition="Exists('$(AgentFarmWinUIAnalyzerRoot)\Microsoft.WindowsAppSDK.Analyzers.targets')" />
</Project>
