<?xml version="1.0" encoding="utf-8"?>
<AppInstaller Uri="https://github.com/Freddy-Hexas/Agent-Farm/releases/latest/download/AgentFarm-stable.appinstaller"
              Version="1.5.0.9"
              xmlns="http://schemas.microsoft.com/appx/appinstaller/2018">
  <MainPackage Name="AgentFarm.Desktop"
               Publisher="CN=Agent Farm"
               Version="0.5.0.9"
               ProcessorArchitecture="x64"
               Uri="https://github.com/Freddy-Hexas/Agent-Farm/releases/latest/download/AgentFarm-Native-x64.msix" />
  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="4"
              ShowPrompt="true"
              UpdateBlocksActivation="false" />
    <AutomaticBackgroundTask />
    <ForceUpdateFromAnyVersion>false</ForceUpdateFromAnyVersion>
  </UpdateSettings>
</AppInstaller>